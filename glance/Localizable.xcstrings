        }
      }
    },
    "%lld of %lld samples are low quality": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 个样本质量较低"
          }
        }
      }
    },
    "%lld sample%@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 个样本"
          }
        }
      }
    },
    "%lld/%lld": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld"
          }
        }
      }
    },
    "%lld/9 poses · %lld samples · enrolled %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/9 个姿态 · %2$lld 个样本 · 录入于 %3$@"
