    "Test infrared": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试红外"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kızılötesini test et"
          }
        }
      }
    },
    "Test the Logitech BRIO's infrared sensor. This test does not enable IR face unlock.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试罗技 BRIO 的红外传感器。此测试不会启用红外人脸解锁。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Logitech BRIO'nun kızılötesi sensörünü test edin. Bu test IR yüzle kilit açmayı etkinleştirmez."
          }
        }
      }
    },
    "The BRIO returned no complete infrared frames within five seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BRIO 在五秒内未返回完整的红外帧。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BRIO beş saniye içinde tam bir kızılötesi kare döndürmedi."
          }
        }
      }
    },
    "The IR helper could not complete the test. Check that the BRIO is connected and approve the administrator prompt.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "红外辅助进程未能完成测试。请确认 BRIO 已连接，并批准管理员授权提示。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IR yardımcısı testi tamamlayamadı. BRIO'nun bağlı olduğunu denetleyip yönetici istemini onaylayın."
          }
        }
      }
    },
    "The IR test did not return a complete 340 × 340 infrared image.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "红外测试未返回完整的 340 × 340 红外图像。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IR testi tam bir 340 × 340 kızılötesi görüntü döndürmedi."
          }
        }
      }
    },
    "The animation that appears when unlocking your Mac": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizin kilidi açılırken gösterilen animasyon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁 Mac 时显示的动画"
          }
        }
      }
    },
    "The camera did not provide a fresh frame. Try again.": {
      "localizations": {
