        }
      }
    },
    "%llds": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒"
          }
        }
      }
    },
    "(ArcFace unavailable — see log)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（ArcFace 不可用——详情见日志）"
          }
        }
      }
    },
    "2-point (eyes only)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两点（仅眼睛）"
          }
        }
      }
    },
    "5-point": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五点"
          }
        }
      }
    },
    "7 days": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天"
          }
        }
      }
    },
    "14 days": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "14 天"
          }
        }
      }
    },
    "30 days": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天"
          }
        }
      }
    },
    "A device-shaped rectangle overlaps the face — a phone or tablet held up.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备形状的矩形覆盖了人脸——像是举起的手机或平板。"
          }
        }
      }
    },
    "A device-shaped rectangle was detected around the face — this looks like a photo or screen.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在人脸周围检测到设备形状的矩形——看起来像照片或屏幕。"
          }
        }
      }
    },
    "A face named \"%@\" is already enrolled.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经录入了名为 \"%@\" 的人脸。"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Abstaining — not enough head rotation to tell a plane from a still 3D face.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弃权——头部转动不足，无法区分平面图像和静止的 3D 人脸。"
          }
        }
      }
    },
    "Accessibility": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility not granted — open System Settings and enable glance.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予辅助功能权限。请打开系统设置并启用 glance。"
          }
        }
      }
    },
    "Accessibility permission required. Open System Settings → Privacy & Security → Accessibility and enable glance.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限。请打开“系统设置”→“隐私与安全性”→“辅助功能”，并启用 glance。"
          }
        }
      }
    },
    "Add Identity": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加身份"
          }
        }
      }
    },
    "Aligned face": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已对齐人脸"
          }
        }
      }
    },
    "Aligned input": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已对齐输入"
          }
        }
      }
    },
    "Alignment: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对齐方式：%@"
          }
        }
      }
    },
    "Allow Glance to recognize your face": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Glance 识别你的脸"
          }
        }
      }
    },
    "Allow Glance to unlock your Mac": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Glance 解锁你的 Mac"
          }
        }
      }
    },
    "Also requires proof of a real face.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还要求证明这是真人。"
          }
        }
      }
    },
    "Animation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画"
          }
        }
      }
    },
    "Any one firing passes liveness. None firing is not a failure — the scan just keeps looking.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任一信号触发即通过活体检测。没有触发并不算失败，扫描会继续等待。"
          }
        }
      }
    },
    "ArcFace model produced an unexpected output: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArcFace 模型输出异常：%@"
          }
        }
      }
    },
    "ArcFace unavailable (%@) — using Vision Feature Print instead.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArcFace 不可用（%@）——改用 Vision Feature Print。"
          }
        }
      }
    },
    "ArcFace.mlpackage/mlmodelc not found in the app bundle. Run tools/convert_arcface.py, then add glance/Models/ArcFace.mlpackage to the Xcode project.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用包中未找到 ArcFace.mlpackage/mlmodelc。请运行 tools/convert_arcface.py，然后将 glance/Models/ArcFace.mlpackage 添加到 Xcode 项目。"
          }
        }
      }
    },
    "ArcFaceEmbedder expects a %lldx%lld aligned image, got %lldx%lld. Run the face through FaceAligner first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArcFaceEmbedder 需要尺寸为 %1$lldx%2$lld 的已对齐图像，但收到 %3$lldx%4$lld。请先通过 FaceAligner 处理人脸。"
          }
        }
      }
    },
