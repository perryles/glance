          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera yardımcısı zaman aşımına uğradı."
          }
        }
      }
    },
    "The camera helper was interrupted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摄像头辅助进程被中断。"
          }
        },
        "tr": {
