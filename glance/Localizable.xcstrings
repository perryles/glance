          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance 设置"
          }
        }
      }
    },
    "Glance is not as secure as Apple's FaceID or TouchID.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance, Apple'ın Face ID veya Touch ID özellikleri kadar güvenli değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance 不如 Apple 的 Face ID 或 Touch ID 安全。"
          }
        }
      }
    },
    "Glance unlocks its session by itself when it opens, so you don't need Touch ID or your password after every login. Logging in to macOS becomes the only check. Auto lock, or locking the session yourself, still keeps it locked until the next login.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance 启动时会自行解锁会话，因此每次登录后无需再次使用 Touch ID 或密码。此时仅以 macOS 登录作为验证。自动锁定或手动锁定会话后，会话仍保持锁定，直到下一次登录。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance açıldığında oturum kilidini kendisi açar. Her girişten sonra Touch ID veya parola gerekmez. Tek doğrulama macOS oturum açma işlemi olur. Oturumu elle veya otomatik kilitlerseniz bir sonraki girişe kadar kilitli kalır."
          }
        }
      }
    },
    "Gloss/glare": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlaklık/yansıma"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光泽/反光"
          }
        }
      }
    },
    "Grant": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin Ver"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权"
          }
        }
      }
    },
    "Granted": {
      "extractionState": "manual",
      "localizations": {
