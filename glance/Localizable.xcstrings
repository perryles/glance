{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    " Camera startup: %.2fs; colour/liveness: %.2fs; camera handoff: %.2fs; IR analysis: %.2fs; password submission: %.2fs; total to submission: %.2fs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": " Camera startup: %1$.2fs; colour/liveness: %2$.2fs; camera handoff: %3$.2fs; IR analysis: %4$.2fs; password submission: %5$.2fs; total to submission: %6$.2fs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 摄像头启动 %.2f 秒，彩色识别与活体检测 %.2f 秒，摄像头交接 %.2f 秒，红外分析 %.2f 秒，密码提交 %.2f 秒，总提交耗时 %.2f 秒。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Kamera başlangıcı %.2f sn, renkli görüntü/canlılık %.2f sn, kamera devri %.2f sn, IR analizi %.2f sn, parola gönderimi %.2f sn, toplam %.2f sn."
          }
        }
      }
    },
    " Live-face frames: %d; blink: %.2f; head-depth: %.2f (confidence %.2f); 3D shape: %.2f (confidence %.2f).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": " Live-face frames: %1$d; blink: %2$.2f; head-depth: %3$.2f (confidence %4$.2f); 3D shape: %5$.2f (confidence %6$.2f)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 活体帧数 %d，眨眼 %.2f，头部深度 %.2f（置信度 %.2f），三维形状 %.2f（置信度 %.2f）。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Canlı yüz karesi %d, göz kırpma %.2f, baş derinliği %.2f (güven %.2f), 3B şekil %.2f (güven %.2f)."
          }
        }
      }
    },
    " [STALE — re-enroll under current model]": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " [ESKİ — geçerli modelle yeniden kaydedin]"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "【已过期——请在当前模型下重新录入】"
          }
        }
      }
    },
    "\"%@\" will stop being recognized until you enroll them again.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden kaydedene kadar \"%@\" tanınmayacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后，\"%@\" 将不再被识别，直到重新录入。"
          }
        }
      }
    },
