          "stringUnit": {
            "state": "translated",
            "value": "人脸数据已加密"
          }
        }
      }
    },
    "Face enrollment": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz kaydı"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸录入"
          }
        }
      }
    },
    "Face features are encrypted with your existing enrollment. Images are not saved. Enable the additional infrared check separately in Recognition settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸特征会随现有录入数据一起加密，图像不会保存。请在识别设置中单独启用附加红外校验。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz özellikleri mevcut kayıtla birlikte şifrelenir. Görüntüler kaydedilmez. Ek kızılötesi denetimi Tanıma ayarlarında ayrıca etkinleştirin."
          }
        }
      }
    },
    "Face not recognized for the system prompt.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem istemi için yüz tanınmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未识别出系统弹窗对应的用户面部。"
          }
        }
      }
    },
    "Face not recognized — hover the notch to try again.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz tanınmadı — yeniden denemek için imleci çentiğin üzerine getirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未识别人脸——将指针悬停在刘海上即可重试。"
          }
        }
      }
    },
    "Face not recognized.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz tanınmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未识别人脸。"
          }
        }
      }
    },
    "Face recognized, but the live-face check did not finish. Blink or gently turn your head and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已识别人脸，但活体检测未完成。请眨眼或轻轻转头后重试。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz tanındı, ancak canlılık denetimi tamamlanmadı. Göz kırpıp veya başınızı hafifçe çevirip yeniden deneyin."
          }
        }
      }
    },
    "Face recognized, but unlocking failed. ": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已识别人脸，但解锁失败。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüz tanındı, ancak kilit açılamadı. "
          }
        }
      }
    },
    "Face unlock is on, but no password is stored yet.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzle kilit açma etkin, ancak henüz bir parola kayıtlı değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸解锁已开启，但尚未存储密码。"
          }
        }
      }
    },
    "Face unlock is on, but the session is locked — authenticate once from Password settings first.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzle kilit açma etkin, ancak oturum kilitli — önce Parola ayarlarından bir kez kimliğinizi doğrulayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸解锁已开启，但会话仍处于锁定状态。请先在“密码”设置中完成一次验证。"
          }
        }
      }
    },
    "Faces detected: %lld": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Algılanan yüz sayısı: %lld"
