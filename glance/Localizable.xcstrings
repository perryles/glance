{
  "sourceLanguage": "en",
  "strings": {
    " [STALE — re-enroll under current model]": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "【已过期——请在当前模型下重新录入】"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " [ESKİ — geçerli modelle yeniden kaydedin]"
          }
        }
      }
    },
    "\"%@\" will stop being recognized until you enroll them again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后，\"%@\" 将不再被识别，直到重新录入。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden kaydedene kadar \"%@\" tanınmayacak."
          }
        }
      }
    },
    "%@ (Default)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（默认）"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Varsayılan)"
          }
        }
      }
    },
    "%@ (disconnected)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已断开连接）"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (bağlı değil)"
          }
        }
      }
    },
    "%lld enrolled": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已录入 %lld 个"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kayıtlı"
          }
        }
      }
    },
    "%lld frames": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 帧"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kare"
          }
        }
      }
    },
    "%lld of %lld samples are low quality": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 个样本质量较低"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld örneğin %1$lld tanesi düşük kaliteli"
          }
        }
      }
    },
    "%lld/%lld": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/%lld"
          }
        }
      }
    },
    "%lld/9 poses · %lld samples · enrolled %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/9 个姿态 · %2$lld 个样本 · 录入于 %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/9 poz · %lld örnek · kayıt tarihi %@"
          }
        }
      }
    },
    "%llds": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sn"
          }
        }
      }
    },
    "(ArcFace unavailable — see log)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（ArcFace 不可用——详情见日志）"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "(ArcFace kullanılamıyor — günlüğe bakın)"
          }
        }
      }
    },
    "2-point (eyes only)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两点（仅眼睛）"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 noktalı (yalnızca gözler)"
          }
        }
      }
    },
    "5-point": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五点"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 noktalı"
          }
        }
      }
    },
    "7 days": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 gün"
          }
        }
      }
    },
    "14 days": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "14 天"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "14 gün"
          }
        }
      }
    },
    "30 days": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "30 gün"
          }
        }
      }
    },
    "A device-shaped rectangle overlaps the face — a phone or tablet held up.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备形状的矩形覆盖了人脸——像是举起的手机或平板。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzle örtüşen cihaz biçiminde bir dikdörtgen var — telefon veya tablet tutuluyor olabilir."
          }
        }
      }
    },
    "A device-shaped rectangle was detected around the face — this looks like a photo or screen.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在人脸周围检测到设备形状的矩形——看起来像照片或屏幕。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzün çevresinde cihaz biçiminde bir dikdörtgen algılandı — fotoğraf veya ekran olabilir."
          }
        }
      }
    },
    "A face named \"%@\" is already enrolled.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经录入了名为 \"%@\" 的人脸。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" adlı bir yüz zaten kayıtlı."
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        }
      }
    },
    "Abstaining — not enough head rotation to tell a plane from a still 3D face.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弃权——头部转动不足，无法区分平面图像和静止的 3D 人脸。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karar verilemiyor — düz bir yüzey ile hareketsiz üç boyutlu bir yüzü ayırt etmek için baş dönüşü yetersiz."
          }
        }
      }
    },
    "Accessibility": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        }
      }
    },
    "Accessibility not granted — open System Settings and enable glance.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予辅助功能权限。请打开系统设置并启用 glance。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni verilmedi — Sistem Ayarları'nı açıp glance için izin verin."
          }
        }
      }
    },
    "Accessibility permission required. Open System Settings → Privacy & Security → Accessibility and enable glance.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限。请打开“系统设置”→“隐私与安全性”→“辅助功能”，并启用 glance。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekiyor. Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünden glance için izin verin."
          }
        }
      }
    },
    "Add Identity": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加身份"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik Ekle"
          }
        }
      }
    },
    "Aligned face": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已对齐人脸"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizalanmış yüz"
          }
        }
      }
    },
    "Aligned input": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已对齐输入"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizalanmış girdi"
          }
        }
      }
    },
    "Alignment: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对齐方式：%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizalama: %@"
          }
        }
      }
    },
    "Allow Glance to recognize your face": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Glance 识别你的脸"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance'ın yüzünüzü tanımasına izin verin"
          }
        }
      }
    },
    "Allow Glance to unlock your Mac": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Glance 解锁你的 Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance'ın Mac'inizin kilidini açmasına izin verin"
          }
        }
      }
    },
    "Also requires proof of a real face.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还要求证明这是真人。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek bir yüz olduğuna dair kanıt da gerektirir."
          }
        }
      }
    },
    "Animation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasyon"
          }
        }
      }
    },
    "Any one firing passes liveness. None firing is not a failure — the scan just keeps looking.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任一信号触发即通过活体检测。没有触发并不算失败，扫描会继续等待。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sinyallerden herhangi biri algılanırsa canlılık doğrulanır. Hiçbiri algılanmazsa tarama devam eder."
          }
        }
      }
    },
    "ArcFace model produced an unexpected output: %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArcFace 模型输出异常：%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ArcFace modeli beklenmeyen bir çıktı üretti: %@"
          }
        }
      }
    },
    "ArcFace unavailable (%@) — using Vision Feature Print instead.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArcFace 不可用（%@）——改用 Vision Feature Print。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ArcFace kullanılamıyor (%@) — Vision Feature Print kullanılıyor."
          }
        }
      }
    },
    "ArcFace.mlpackage/mlmodelc not found in the app bundle. Run tools/convert_arcface.py, then add glance/Models/ArcFace.mlpackage to the Xcode project.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用包中未找到 ArcFace.mlpackage/mlmodelc。请运行 tools/convert_arcface.py，然后将 glance/Models/ArcFace.mlpackage 添加到 Xcode 项目。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama paketinde ArcFace.mlpackage/mlmodelc bulunamadı. tools/convert_arcface.py dosyasını çalıştırıp glance/Models/ArcFace.mlpackage dosyasını Xcode projesine ekleyin."
          }
        }
      }
    },
    "ArcFaceEmbedder expects a %lldx%lld aligned image, got %lldx%lld. Run the face through FaceAligner first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ArcFaceEmbedder 需要尺寸为 %1$lldx%2$lld 的已对齐图像，但收到 %3$lldx%4$lld。请先通过 FaceAligner 处理人脸。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ArcFaceEmbedder %lldx%lld boyutunda hizalanmış bir görüntü bekliyor, alınan boyut %lldx%lld. Önce yüzü FaceAligner ile işleyin."
          }
        }
      }
    },
    "Authenticate to enroll another face": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证以录入另一张人脸"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir yüz kaydetmek için kimliğinizi doğrulayın"
          }
        }
      }
    },
    "Authenticate to re-enroll this face": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证以重新采集此人脸"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yüzü yeniden kaydetmek için kimliğinizi doğrulayın"
          }
        }
      }
    },
    "Authenticate to re-enroll your face": {
      "extractionState": "manual",
      "localizations": {
