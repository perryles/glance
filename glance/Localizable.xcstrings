            "state": "translated",
            "value": "glance'ı ayarlamak veya kullanmak için kimliğinizi doğrulayın"
          }
        }
      }
    },
    "Authenticate to use Face Lab": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证以使用人脸实验室"
