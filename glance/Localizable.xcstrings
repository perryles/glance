            "state": "translated",
            "value": "Kamera yardımcısı kesintiye uğradı."
          }
        }
      }
    },
    "The face model changed. Clear the reference and capture it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人脸模型已更改。请清除参考数据后重新采集。"
          }
        },
