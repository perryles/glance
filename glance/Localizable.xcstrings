    "A device-shaped rectangle overlaps the face — a phone or tablet held up.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzle örtüşen cihaz biçiminde bir dikdörtgen var — telefon veya tablet tutuluyor olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备形状的矩形覆盖了人脸——像是举起的手机或平板。"
          }
        }
      }
    },
    "A device-shaped rectangle was detected around the face — this looks like a photo or screen.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüzün çevresinde cihaz biçiminde bir dikdörtgen algılandı — fotoğraf veya ekran olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在人脸周围检测到设备形状的矩形——看起来像照片或屏幕。"
          }
        }
      }
    },
    "A face named \"%@\" is already enrolled.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" adlı bir yüz zaten kayıtlı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经录入了名为 \"%@\" 的人脸。"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Abstaining — not enough head rotation to tell a plane from a still 3D face.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karar verilemiyor — düz bir yüzey ile hareketsiz üç boyutlu bir yüzü ayırt etmek için baş dönüşü yetersiz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弃权——头部转动不足，无法区分平面图像和静止的 3D 人脸。"
          }
        }
      }
    },
    "Accessibility": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        }
      }
    },
    "Accessibility not granted — open System Settings and enable glance.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni verilmedi — Sistem Ayarları'nı açıp glance için izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予辅助功能权限。请打开系统设置并启用 glance。"
          }
        }
      }
    },
    "Accessibility permission required. Enable this app in System Settings → Privacy & Security → Accessibility.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限。请在“系统设置 → 隐私与安全性 → 辅助功能”中启用此应用。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekiyor. Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünde bu uygulamaya izin verin."
          }
        }
      }
    },
    "Accessibility permission required. Open System Settings → Privacy & Security → Accessibility and enable glance.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik izni gerekiyor. Sistem Ayarları → Gizlilik ve Güvenlik → Erişilebilirlik bölümünden glance için izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要辅助功能权限。请打开“系统设置”→“隐私与安全性”→“辅助功能”，并启用 glance。"
          }
        }
      }
    },
    "Across reference scans: %.3f to %.3f": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Across reference scans: %1$.3f to %2$.3f"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考样本间相似度 %.3f 至 %.3f"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans taramaları arasında %.3f ile %.3f"
          }
        }
      }
    },
    "Add Identity": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik Ekle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加身份"
          }
        }
      }
    },
    "Add reference scan (%lld/3)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加参考扫描（%lld/3）"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans taraması ekle (%lld/3)"
          }
        }
      }
    },
    "Adds a separate infrared match after colour-camera recognition and Heavy liveness checks. Enroll infrared for each identity in Your Face first. A missing camera, helper or enrollment prevents face unlock; your Mac password still works.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在彩色人脸识别和重度活体检测后增加独立的红外身份校验。请先在人脸设置中为各身份录入红外数据。摄像头、辅助进程或录入数据缺失时，人脸解锁会停止，你仍可手动输入 Mac 密码。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renkli kamera tanıması ve Güçlü canlılık denetiminden sonra ayrı bir kızılötesi eşleşme ekler. Önce Yüz ayarlarında her kimlik için kızılötesi kayıt yapın. Kamera, yardımcı veya kayıt eksikse yüzle kilit açma durur. Mac parolanızla giriş yapabilirsiniz."
          }
        }
      }
    },
    "Administrator approval was cancelled. The IR test did not run.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消管理员授权，红外测试未运行。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetici onayı iptal edildi. IR testi çalıştırılmadı."
          }
        }
      }
    },
    "Aligned face": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hizalanmış yüz"
          }
