    "Authentication was cancelled or failed.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证已取消或失败。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik doğrulama iptal edildi veya başarısız oldu."
          }
        }
      }
    },
    "Auto lock session": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动锁定会话"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumu otomatik kilitle"
          }
        }
      }
    },
    "Auto retry once after failure": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败后自动重试一次"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarısız olursa bir kez otomatik yeniden dene"
          }
        }
      }
    },
    "Automatically check for updates": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri otomatik denetle"
          }
        }
      }
    },
    "Back": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一步"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri"
          }
        }
      }
    },
    "Behaviour": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行为"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davranış"
          }
        }
      }
    },
    "Best match: %@ — centroid %@, max %@": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最佳匹配：%1$@——中心 %2$@，最大 %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En iyi eşleşme: %@ — merkez benzerliği %@, en yüksek %@"
          }
        }
      }
