          }
        }
      }
    },
    "Allow Glance to recognize your face": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance'ın yüzünüzü tanımasına izin verin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Glance 识别你的脸"
          }
        }
      }
    },
    "Allow Glance to unlock your Mac": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance'ın Mac'inizin kilidini açmasına izin verin"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许 Glance 解锁你的 Mac"
          }
        }
      }
    },
    "Allow camera access in System Settings to run the IR test.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许摄像头访问，以运行红外测试。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IR testini çalıştırmak için Sistem Ayarları'nda kamera erişimine izin verin."
          }
        }
      }
    },
    "Allow iPhone cameras": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用 iPhone 摄像头"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone kameralarına izin ver"
          }
        }
      }
    },
    "Also requires proof of a real face.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçek bir yüz olduğuna dair kanıt da gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还要求证明这是真人。"
          }
        }
      }
    },
    "Animation": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasyon"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动画"
          }
        }
      }
    },
    "Any one firing passes liveness. None firing is not a failure — the scan just keeps looking.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sinyallerden herhangi biri algılanırsa canlılık doğrulanır. Hiçbiri algılanmazsa tarama devam eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任一信号触发即通过活体检测。没有触发并不算失败，扫描会继续等待。"
          }
        }
      }
    },
    "Approve the camera helper in System Settings → Login Items & Extensions, then return here.": {
