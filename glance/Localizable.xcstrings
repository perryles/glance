{
  "sourceLanguage": "en",
  "strings": {
    " [STALE — re-enroll under current model]": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "【已过期——请在当前模型下重新录入】"
          }
        }
      }
    },
    "\"%@\" will stop being recognized until you enroll them again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后，\"%@\" 将不再被识别，直到重新录入。"
          }
        }
      }
    },
    "%@ (Default)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（默认）"
          }
        }
      }
    },
    "%@ (disconnected)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（已断开连接）"
          }
        }
      }
    },
    "%lld enrolled": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已录入 %lld 个"
